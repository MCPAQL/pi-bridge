{
  "servers": [
    {
      "name": "dollhouse",
      "transport": "stdio",
      "command": "npx",
      "args": ["--yes", "@dollhousemcp/mcp-server"],
      "direct": true,
      "trust": "developer",
      "endpointMode": "multi"
    },
    {
      "name": "github",
      "adapter": "/absolute/path/to/your/adapter",
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}" },
      "trust": "user",
      "endpointMode": "multi"
    }
  ]
}

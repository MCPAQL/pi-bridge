  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCPAQL/pi-bridge.git"
  },
  "keywords": [
    "mcp",
    "mcp-aql",
    "mcpaql",
    "pi",
    "pi-coding-agent",
    "agent",
    "extension",
    "bridge"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.70.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}

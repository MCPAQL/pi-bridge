{
  "name": "@mcpaql/pi-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Pi coding-agent extension that hosts MCP-AQL adapters and exposes their CRUDE operations as Pi tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
